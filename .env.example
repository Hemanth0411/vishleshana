# NVIDIA NIM API
# Get your key at: https://integrate.api.nvidia.com
NIM_API_KEY=your_key_here
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.1-8b-instruct
NIM_MAX_TOKENS=1024

# Analysis settings
COMPLEXITY_THRESHOLD=10
MAX_FILES=150

# Temp directory for cloned repos (use a path that exists on your system)
# Linux/Mac: /tmp/codelens_repos
# Windows:   C:/tmp/codelens_repos
TEMP_DIR=/tmp/codelens_repos
